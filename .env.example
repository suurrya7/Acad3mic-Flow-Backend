# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# AI Configuration (Internal Only - never expose)
GEMINI_API_KEY=your_gemini_api_key

# Payment Configuration (PayU)
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt

# App Configuration
# ENV must be 'development' or 'production'
ENV=development

# CORS Origins for Production (comma separated)
PROD_ORIGINS=https://acad3mic-flow.com,https://api.acad3mic-flow.com

# API Base URL for webhooks and callbacks
# For development: http://localhost:8000
# For production: https://api.acad3mic-flow.com
API_BASE_URL=http://localhost:8000
